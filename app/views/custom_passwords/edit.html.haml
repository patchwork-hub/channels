
.edit-email-section.form-container
  = form_with model: @user, url: custom_passwords_edit_path(reset_password_token: params[:reset_password_token]), class: "form-container" do |form|
    = render 'shared/error_messages', object: @user

    - if !use_seamless_external_login? || @user.encrypted_password.present?
      = form.hidden_field :reset_password_token 

      .form-group
        = form.label :password, class: "form-label fw-bold"
        = form.password_field :password, class: "form-control", placeholder: "Enter your new password"

      .form-group
        = form.label :password_confirmation, class: "form-label fw-bold"
        = form.password_field :password_confirmation, class: "form-control", placeholder: "Confirm your new password"

      .d-flex.justify-content-center.mt-3
        = form.submit "Save Password", class: "btn btn-primary px-4 py-2"

    - else
      .alert.alert-info.text-center.mt-3
        %p.hint= t('users.seamless_external_login')