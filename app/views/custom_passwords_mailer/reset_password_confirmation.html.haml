-#     %span Password Reset Verification OTP

%tr.text
  %td{align: "center", valign: "middle"}
    %div
      ="Dear, #{@user.account.display_name.presence || @user.account.username}"
    
    %div
      To reset your password, please click the link below:
      %br
      = link_to "Reset Password", custom_passwords_edit_url(reset_password_token: @user.reset_password_token)

    .note
      If you didn't request this, please ignore this email.
      %br
      Your password won't change until you verify your email with the above OTP and update the password.
